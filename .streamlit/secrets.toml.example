# Copy to .streamlit/secrets.toml (local) or paste into
# Streamlit Community Cloud → App → Settings → Secrets.
# You only need ONE provider key.

ANTHROPIC_API_KEY = "sk-ant-..."
# OPENAI_API_KEY = "sk-..."
# GEMINI_API_KEY = "AIza..."      # free tier available at aistudio.google.com

# Optional: Discord or Slack incoming-webhook URL for send_notification.
# Without it, notifications are written to a local outbox file instead.
# WEBHOOK_URL = "https://discord.com/api/webhooks/..."
